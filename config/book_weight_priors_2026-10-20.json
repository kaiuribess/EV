    ],
    "allowed_markets": [
      "moneyline"
    ],
    "phase": "pregame",
    "proposed_share_percent": 15,
    "rescale_existing_weights_by": 0.85,
    "requirements": [
      "Complete matching outcome set",
      "Validated source freshness and tradability",
      "Independent out-of-sample test against model without BookMaker"
    ],
    "note": "A candidate paper-test override, not a claim that a 60-second board check meets live execution needs."
  },
  "aggregation": {
    "unit_of_weight": "canonical_book_not_provider",
    "target_venue_reference_weight": 0,
    "exchange_reference_default_weight": 0,
    "deduplicate_same_book_across_providers": true,
    "duplicate_selection_policy": "Choose the most recently validated complete outcome set under documented observation semantics, not the most favorable price or newest transport timestamp. Reject unresolved conflicts.",
    "devig_before_averaging": true,
    "primary_devig_candidate": "power",
    "sensitivity_devig_candidate": "multiplicative",
    "blend": "weighted_arithmetic_mean_of_devigged_probabilities",
    "effective_weight": "base_weight * measured_freshness_factor * eligibility_indicator",
    "renormalize_only_after_gates_pass": true,
    "unresolved_price_disagreement_policy": "flag_and_withhold_execution_do_not_automatically_discard_a_sharp_first_mover",
    "method_sensitivity_policy": "Report both model EV estimates; do not execute if the apparent edge depends solely on the selected devig method."
  },
  "eligibility_rules": {
    "same_event_player_stat_threshold_period_and_settlement_rules": true,
    "require_complete_mutually_exclusive_exhaustive_outcomes": true,
    "require_active_unsuspended_market_status": true,
    "require_validated_outcome_level_observation": true,
    "require_synchronized_sides_from_same_book": true,
    "reject_topups_stale_rows_and_unresolved_truncation": true,
    "require_explicit_push_model_when_refund_possible": true,
    "no_automatic_integer_to_halfpoint_conversion": true,
    "unpriced_push_or_rule_mismatch_policy": "skip",
    "one_sided_anytime_scorer_markets": "skip_for_standard_devig",
    "unknown_freshness_or_status_policy": "paper_research_only",
    "live_execution": "disabled_until_independently_validated"
  },
  "freshness_contract": {
    "record_separately": [
      "source_price_changed_at",
      "source_observed_at",
      "provider_observed_at",
      "received_at",
      "market_status",
      "source_health"
    ],
    "do_not_use_as_selection_freshness": [
      "websocket_heartbeat",
      "frame_send_time",
      "last_price_change_alone",
      "unqualified_fixture_verification_time"
    ],
    "ttl_seconds_by_provider_book_sport_market_phase": {},
    "missing_ttl_policy": "No execution eligibility; measure source lag and quote verification before setting TTL.",
    "note": "A price can remain unchanged and still be fresh. A newly delivered row can also contain an old price."
  },
  "validation_plan": {
    "log_full_candidate_universe_including_rejections": true,
    "baselines": [
      "equal_weight_eligible_books",
      "single_anchor",
      "these_starting_priors",
      "learned_nonnegative_regularized_weights"
    ],
    "splits": "Time-ordered walk-forward; keep all alternate lines, sides and repeated observations of a game within the same split; aggregate or weight repeated snapshots to avoid pseudo-replication.",
    "metrics": [
      "out_of_sample_log_loss",
      "out_of_sample_brier_score",
      "reliability_curves",
      "closing_line_comparison",
      "paper_execution_net_returns_and_fill_quality"
    ],
    "weight_learning": "Fit nonnegative sum-to-one weights with shrinkage toward parent league/market priors; do not fit thin stat-specific groups independently.",
    "do_not_use": [
      "future_or_closing_information_at_decision_time",
      "random_quote_level_train_test_split",
      "short_run_win_rate_as_sole_objective",
      "unverified_provider_timestamps_as_ground_truth_latency"
    ],
    "exchange_challenger": "Test separately with executable bid/ask, depth, fees and target-venue exclusion; do not copy large exchange weights from third-party research without reproducing results."
  }

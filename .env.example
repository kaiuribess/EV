# Copy to .env; keep secrets on this PC. Never commit .env or private key files.
# All adapters are independently disabled until enabled in Provider Center.
PARLAY_API_KEY=
OWLS_API_KEY=
ODDSPAPI_API_KEY=
ODDIZE_API_KEY=
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Current Novig v3 requires the key UUID AND its signing private key.
NOVIG_API_KEY=
NOVIG_PRIVATE_KEY_PATH=
# Optional management pair for operator setup/read-only diagnostics, not trading.
# The runtime uses the trading pair above; these cannot place orders or stream.
NOVIG_PRODUCTION_MANAGEMENT_API_KEY=
NOVIG_PRODUCTION_MANAGEMENT_PRIVATE_KEY_PATH=
# ProphetX access key and secret are exchanged for temporary tokens.
PROPHETX_API_KEY=
PROPHETX_SECRET_KEY=
# Personal Polymarket US developer-portal credentials; not international wallet keys.
# This adapter supports read-only monitoring; native orders remain unsupported.
POLYMARKET_US_API_KEY_ID=
POLYMARKET_US_SECRET_KEY=

EV_MODE=demo
EV_AUTO_TRADE=false
EV_LIVE_ENABLED=false
EV_HOST=127.0.0.1
EV_PORT=8001
EV_DATABASE_PATH=data/evplatform.db
EV_DEMO_INTERVAL=0.5
EV_DEMO_SEED=73

